# Public URL used when generating QR links. Required in production.
APP_URL="https://app.example.com"

# Use a PostgreSQL URL in the next persistence migration; never commit a real value.
DATABASE_URL="postgresql://laris:laris_local_only@127.0.0.1:5433/laris_pos"

# Generate a 32+ character random value for sessions; never reuse this example.
JWT_SECRET="replace-with-a-random-32-character-minimum-secret"

# Set only in local demo development. Demo reset is disabled by default and always
# disabled when NODE_ENV=production.
ENABLE_DEMO_RESET="false"

# Runtime configuration
PORT="3000"
NODE_ENV="development"
