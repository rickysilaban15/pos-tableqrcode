# Public URL used when generating QR links. Required in production.
APP_URL="https://app.example.com"

# PostgreSQL 16 connection URI (local isolated port 5433; never commit real credentials).
DATABASE_URL="postgresql://laris:laris_local_only@127.0.0.1:5433/laris_pos"

# Generate a 32+ character random value for sessions; never reuse this example.
JWT_SECRET="replace-with-a-random-32-character-minimum-secret"

# Set only in local demo development. Demo reset is disabled by default and always
# disabled when NODE_ENV=production.
ENABLE_DEMO_RESET="false"

# Runtime configuration
PORT="3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Midtrans Dynamic QRIS Sandbox Integration (Optional — App works without this)
# -----------------------------------------------------------------------------
# Enable dynamic QRIS only when testing Midtrans Sandbox. Production mode is blocked.
MIDTRANS_ENABLED="false"
MIDTRANS_ENVIRONMENT="sandbox"

# Sandbox Server Key from Midtrans MAP -> Settings -> Access Keys (starts with SB-Mid-server-...)
MIDTRANS_SERVER_KEY="replace-with-sb-mid-server-sandbox-key"

# Optional dedicated Notification Signature Key if configured separately in Midtrans MAP;
# defaults to MIDTRANS_SERVER_KEY when omitted.
MIDTRANS_SIGNATURE_KEY=""

# Explicitly designate ONE sandbox test merchant (merchant UUID or merchant slug, e.g. laris-coffee)
# so sandbox credentials are never shared unintentionally across tenants.
MIDTRANS_SANDBOX_MERCHANT_ID=""

# Optional authorized public HTTPS base URL for live Midtrans webhook delivery tests
# (e.g. https://sandbox-webhook.example.com). Localhost works without this via Get Status reconciliation.
PAYMENT_WEBHOOK_BASE_URL=""
